<?xml version="1.0" encoding="UTF-8"?>
<!-- Coordinate e dipendenza mantenute dall'esempio del docente. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>it.amdani.school</groupId>
    <artifactId>smtp-example</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <properties>
        <!-- Il progetto usa il JDK 21 già preparato nell'ambiente. -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!-- Unica libreria dell'allegato: versione invariata. -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>
    </dependencies>
</project>
